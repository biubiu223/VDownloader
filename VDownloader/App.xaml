<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="VDownloader.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:VDownloader.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ============ 主题色（浅色 / 深色） ============ -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#FFD9E4F7" />
                        <GradientStop Offset="0.55" Color="#B3E3EAF8" />
                        <GradientStop Offset="1" Color="#00E8EDF8" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="HeroTintBrush" StartPoint="0,0" EndPoint="1,0.4">
                        <GradientStop Offset="0" Color="#00FFFFFF" />
                        <GradientStop Offset="0.55" Color="#40C9D8FF" />
                        <GradientStop Offset="1" Color="#66E3C8FF" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="HeroMockBrush" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="HeroMockStrokeBrush" Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="HeroMockLineBrush" Color="#1A000000" />
                    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#B3FFFFFF" />
                    <SolidColorBrush x:Key="DangerTextBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="SuccessTextBrush" Color="#0F7B0F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#FF1F2738" />
                        <GradientStop Offset="0.55" Color="#B3202634" />
                        <GradientStop Offset="1" Color="#00202020" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="HeroTintBrush" StartPoint="0,0" EndPoint="1,0.4">
                        <GradientStop Offset="0" Color="#00000000" />
                        <GradientStop Offset="0.55" Color="#332B4A8F" />
                        <GradientStop Offset="1" Color="#55573A8F" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="HeroMockBrush" Color="#992C2C2C" />
                    <SolidColorBrush x:Key="HeroMockStrokeBrush" Color="#22FFFFFF" />
                    <SolidColorBrush x:Key="HeroMockLineBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="TileBackgroundBrush" Color="#992B2B2B" />
                    <SolidColorBrush x:Key="DangerTextBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="SuccessTextBrush" Color="#6CCB5F" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="HeroBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="HeroTintBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="HeroMockBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="HeroMockStrokeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="HeroMockLineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="TileBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="DangerTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SuccessTextBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- ============ 通用样式 ============ -->
            <Thickness x:Key="PagePadding">36,0,36,36</Thickness>

            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
                <Setter Property="Margin" Value="0,36,0,4" />
            </Style>

            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="FontSize" Value="18" />
                <Setter Property="Margin" Value="2,28,0,10" />
            </Style>

            <Style x:Key="SettingsGroupHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="Margin" Value="1,26,0,6" />
            </Style>

            <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- 透明的小图标按钮（悬停时才显示底色） -->
            <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
            </Style>

            <!-- 首页顶部的大卡片（模仿 WinUI Gallery 的 HeaderTile） -->
            <Style x:Key="HeaderTileStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="198" />
                <Setter Property="Height" Value="220" />
                <Setter Property="Padding" Value="22,24,22,16" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Background" Value="{ThemeResource TileBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <!-- 设置卡片（模仿 Windows 11 设置页的 SettingsCard） -->
            <Style TargetType="controls:SettingsCard">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="16,12" />
                <Setter Property="MinHeight" Value="68" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="controls:SettingsCard">
                            <Grid
                                MinHeight="{TemplateBinding MinHeight}"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                ColumnSpacing="16"
                                CornerRadius="{TemplateBinding CornerRadius}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" MinWidth="160" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    x:Name="PART_Icon"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Glyph="{TemplateBinding Glyph}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock Text="{TemplateBinding Header}" TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="PART_Description"
                                        Style="{StaticResource SecondaryTextStyle}"
                                        Text="{TemplateBinding Description}" />
                                </StackPanel>
                                <ContentPresenter
                                    Grid.Column="2"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
