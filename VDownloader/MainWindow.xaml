<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="VDownloader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="万能视频下载器">

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= 标题栏 ================= -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                x:Name="BackButton"
                Width="40"
                Height="36"
                Margin="4,0,0,0"
                VerticalAlignment="Center"
                Click="BackButton_Click"
                IsEnabled="False"
                Style="{StaticResource IconButtonStyle}"
                ToolTipService.ToolTip="返回">
                <FontIcon FontSize="14" Glyph="&#xE72B;" />
            </Button>
            <Grid x:Name="AppTitleBar" Grid.Column="1" Background="Transparent">
                <StackPanel
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="12">
                    <Image Width="16" Height="16" Source="ms-appx:///Assets/logo-32.png" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="万能视频下载器" />
                    <TextBlock
                        x:Name="TitleBadge"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- ================= 左侧导航 ================= -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="True"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            ItemInvoked="NavView_ItemInvoked"
            OpenPaneLength="280"
            PaneDisplayMode="Auto"
            SelectionChanged="NavView_SelectionChanged">

            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="QuickBox"
                    PlaceholderText="粘贴链接，回车立即下载"
                    QuerySubmitted="QuickBox_QuerySubmitted">
                    <AutoSuggestBox.QueryIcon>
                        <FontIcon FontSize="12" Glyph="&#xE896;" />
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>

            <NavigationView.MenuItems>
                <NavigationViewItem Content="首页" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="TasksItem" Content="下载任务" Tag="tasks">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="TasksBadge" Visibility="Collapsed" />
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="B站账号" Tag="account">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE77B;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItemSeparator />
                <NavigationViewItem Content="运行日志" Tag="log">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D9;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="支持的网站"
                    SelectsOnInvoked="False"
                    Tag="sites">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE774;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Margin="24,0,24,0">
                    <!-- 通用提示 -->
                    <InfoBar x:Name="MessageBar" IsOpen="False" />
                    <!-- 新版本提示 -->
                    <InfoBar
                        x:Name="UpdateBar"
                        IsOpen="False"
                        Severity="Success"
                        Title="发现新版本">
                        <InfoBar.ActionButton>
                            <Button
                                Click="UpdateDownload_Click"
                                Content="前往下载"
                                Style="{StaticResource AccentButtonStyle}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <!-- 剪贴板识别提示 -->
                    <InfoBar
                        x:Name="ClipboardBar"
                        Closed="ClipboardBar_Closed"
                        IsOpen="False"
                        Severity="Informational"
                        Title="检测到剪贴板里的视频链接">
                        <InfoBar.ActionButton>
                            <Button
                                Click="ClipboardDownload_Click"
                                Content="立即下载"
                                Style="{StaticResource AccentButtonStyle}" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                </StackPanel>
                <Frame x:Name="ContentFrame" Grid.Row="1" Navigated="ContentFrame_Navigated" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
