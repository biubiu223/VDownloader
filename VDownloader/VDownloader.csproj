<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>VDownloader</RootNamespace>
    <AssemblyName>VDownloader</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>

    <!-- 原生 WinUI 3，免安装（unpackaged），运行库全部打包进程序目录，拷到任何 Win10/11 都能直接运行 -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>zh-Hans;en-US</SatelliteResourceLanguages>
    <DefaultLanguage>zh-CN</DefaultLanguage>

    <Product>万能视频下载器</Product>
    <AssemblyTitle>万能视频下载器</AssemblyTitle>
    <Description>B站 / YouTube / 1800+ 网站视频下载器（WinUI 3 + yt-dlp）</Description>
    <Authors>biubiu223</Authors>
    <Company>biubiu223</Company>
    <Copyright>Copyright © 2026 biubiu223 · GPL-3.0</Copyright>
    <RepositoryUrl>https://github.com/biubiu223/VDownloader</RepositoryUrl>
    <!-- 版本号：发布时由 scripts/build-release.ps1 用 -p:Version=x.y.z 覆盖 -->
    <Version>1.0.1</Version>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\*.png;Assets\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- 随程序附带的外部组件：yt-dlp（下载内核）、FFmpeg（合并音视频）、Deno（YouTube 解析） -->
    <!-- 许可证与第三方说明随程序分发 -->
    <Content Include="..\LICENSE">
      <Link>LICENSE.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\THIRD-PARTY-NOTICES.md">
      <Link>THIRD-PARTY-NOTICES.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\tools\*.exe">
      <Link>tools\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <!-- 免安装 WinUI 应用用 dotnet publish 时不会带上编译后的 XAML（.xbf）和资源索引（.pri），这里补拷过去 -->
  <Target Name="CopyWinUIResourcesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_WinUIRes Include="$(OutDir)**\*.xbf" />
      <_WinUIRes Include="$(OutDir)$(AssemblyName).pri" />
    </ItemGroup>
    <Copy SourceFiles="@(_WinUIRes)" DestinationFiles="@(_WinUIRes->'$(PublishDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>
