<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="VDownloader.Views.FormatDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VDownloader.Models"
    CloseButtonText="取消"
    DefaultButton="Primary"
    PrimaryButtonText="下载所选画质"
    SecondaryButtonText="按预设画质下载"
    Style="{StaticResource DefaultContentDialogStyle}"
    Title="选择画质">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">880</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">820</x:Double>
    </ContentDialog.Resources>

    <Grid Width="700" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock
                x:Name="TitleText"
                MaxLines="2"
                Style="{StaticResource BodyStrongTextBlockStyle}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
            <TextBlock x:Name="MetaText" Style="{StaticResource SecondaryTextStyle}" />
        </StackPanel>

        <InfoBar
            x:Name="HintBar"
            Grid.Row="1"
            IsClosable="False"
            IsOpen="False">
            <InfoBar.ActionButton>
                <Button x:Name="HintAction" Click="HintAction_Click" Content="去扫码登录" />
            </InfoBar.ActionButton>
        </InfoBar>

        <ListView
            x:Name="FormatList"
            Grid.Row="2"
            MaxHeight="360"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:VideoFormatRow">
                    <Grid Padding="4,10" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Label}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Detail}" />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="4"
                            Visibility="{x:Bind HdrVisibility}">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Text="{x:Bind Hdr}" />
                        </Border>
                        <TextBlock
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind SizeText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid x:Name="AudioRow" Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" Text="音轨" />
            <ComboBox x:Name="AudioBox" Grid.Column="1" MinWidth="320" />
        </Grid>

        <TextBlock
            x:Name="NoteText"
            Grid.Row="4"
            Style="{StaticResource SecondaryTextStyle}" />
    </Grid>
</ContentDialog>
