<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VDownloader.Views.TasksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:VDownloader.Models"
    NavigationCacheMode="Required">

    <Grid Padding="36,0,36,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="下载任务" />
                <TextBlock x:Name="SummaryText" Style="{StaticResource SecondaryTextStyle}" FontSize="14" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="OpenFolder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE838;" />
                        <TextBlock Text="下载文件夹" />
                    </StackPanel>
                </Button>
                <Button Click="CancelAll_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE71A;" />
                        <TextBlock Text="全部停止" />
                    </StackPanel>
                </Button>
                <Button Click="ClearFinished_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock Text="清除已结束" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ListView
            x:Name="TaskList"
            Grid.Row="1"
            Padding="0,0,0,24"
            IsItemClickEnabled="False"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,0,0,8" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:DownloadTask">
                    <Border Padding="16,14" Style="{StaticResource CardStyle}">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="44"
                                Height="44"
                                VerticalAlignment="Top"
                                Background="{x:Bind BadgeBrush, Mode=OneWay}"
                                CornerRadius="10">
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="White"
                                    Text="{x:Bind Badge, Mode=OneWay}" />
                            </Border>

                            <StackPanel Grid.Column="1" Spacing="3">
                                <TextBlock
                                    MaxLines="1"
                                    Style="{StaticResource BodyStrongTextBlockStyle}"
                                    Text="{x:Bind Title, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />
                                <TextBlock
                                    MaxLines="1"
                                    Style="{StaticResource SecondaryTextStyle}"
                                    Text="{x:Bind DetailText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <ProgressBar
                                    Margin="0,8,0,4"
                                    IsIndeterminate="{x:Bind IsIndeterminate, Mode=OneWay}"
                                    ShowError="{x:Bind ShowError, Mode=OneWay}"
                                    ShowPaused="{x:Bind ShowPaused, Mode=OneWay}"
                                    Value="{x:Bind Progress, Mode=OneWay}" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon
                                        FontSize="12"
                                        Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                        Glyph="{x:Bind StateGlyph, Mode=OneWay}" />
                                    <TextBlock
                                        MaxLines="3"
                                        Foreground="{x:Bind StatusBrush, Mode=OneWay}"
                                        IsTextSelectionEnabled="True"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind StatusLine, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="2">
                                <Button
                                    Click="Open_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="播放视频"
                                    Visibility="{x:Bind OpenVisibility, Mode=OneWay}">
                                    <FontIcon FontSize="15" Glyph="&#xE768;" />
                                </Button>
                                <Button
                                    Click="Reveal_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="打开所在文件夹">
                                    <FontIcon FontSize="15" Glyph="&#xE838;" />
                                </Button>
                                <Button
                                    Click="Retry_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="重新开始（支持断点续传）"
                                    Visibility="{x:Bind RetryVisibility, Mode=OneWay}">
                                    <FontIcon FontSize="15" Glyph="&#xE72C;" />
                                </Button>
                                <Button
                                    Click="Cancel_Click"
                                    Style="{StaticResource IconButtonStyle}"
                                    ToolTipService.ToolTip="停止"
                                    Visibility="{x:Bind CancelVisibility, Mode=OneWay}">
                                    <FontIcon FontSize="15" Glyph="&#xE711;" />
                                </Button>
                                <Button Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="更多">
                                    <FontIcon FontSize="15" Glyph="&#xE712;" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutItem Click="CopyUrl_Click" Tag="{x:Bind}" Text="复制链接">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE71B;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Click="ShowLog_Click" Tag="{x:Bind}" Text="查看任务日志">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE9D9;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Click="OpenPage_Click" Tag="{x:Bind}" Text="在浏览器中打开">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE774;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Click="Remove_Click" Tag="{x:Bind}" Text="移除任务">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE74D;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- 空状态 -->
        <StackPanel
            x:Name="EmptyState"
            Grid.Row="1"
            Margin="0,0,0,80"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="10">
            <FontIcon FontSize="52" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE896;" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="还没有下载任务" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="在首页或左上角的输入框里粘贴链接，就能开始下载" />
            <Button
                Margin="0,8,0,0"
                HorizontalAlignment="Center"
                Click="GoHome_Click"
                Content="去首页添加"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
