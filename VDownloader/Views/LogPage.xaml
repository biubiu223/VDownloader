<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VDownloader.Views.LogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <Grid Padding="36,0,36,36">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="运行日志" />
                <TextBlock FontSize="14" Style="{StaticResource SecondaryTextStyle}" Text="下载出问题时，这里的信息可以帮你找到原因。单个任务的完整输出可在任务的「更多 → 查看任务日志」里看到。" />
            </StackPanel>
            <StackPanel
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Orientation="Horizontal"
                Spacing="8">
                <Button Click="Copy_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                        <TextBlock Text="复制" />
                    </StackPanel>
                </Button>
                <Button Click="Clear_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock Text="清空" />
                    </StackPanel>
                </Button>
                <Button Click="OpenData_Click">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE8B7;" />
                        <TextBlock Text="数据目录" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Padding="0" Style="{StaticResource CardStyle}">
            <ScrollViewer
                x:Name="LogScroller"
                Padding="16,12"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto">
                <TextBlock
                    x:Name="LogText"
                    FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI"
                    FontSize="12"
                    IsTextSelectionEnabled="True"
                    LineHeight="20" />
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
