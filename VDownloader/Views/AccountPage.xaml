<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="VDownloader.Views.AccountPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    NavigationCacheMode="Required">

    <ScrollViewer>
        <StackPanel MaxWidth="1040" Padding="{StaticResource PagePadding}" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="B站账号" />
            <TextBlock FontSize="14" Style="{StaticResource SecondaryTextStyle}" Text="登录后可下载更高画质。使用 B站官方扫码登录，不需要输入账号密码。" />

            <!-- 账号卡片 -->
            <Border Margin="0,24,0,0" Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <PersonPicture x:Name="Avatar" Width="72" Height="72" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="NameText" Style="{StaticResource SubtitleTextBlockStyle}" Text="未登录" />
                            <Border
                                x:Name="VipBadge"
                                Padding="8,2"
                                VerticalAlignment="Center"
                                Background="#FB7299"
                                CornerRadius="4"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="VipText"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="White" />
                            </Border>
                            <Border
                                x:Name="LevelBadge"
                                Padding="6,1"
                                VerticalAlignment="Center"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="LevelText"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="StatusText" Style="{StaticResource SecondaryTextStyle}" Text="正在检查登录状态…" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            x:Name="LoginButton"
                            Click="Login_Click"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xED14;" />
                                <TextBlock Text="扫码登录" />
                            </StackPanel>
                        </Button>
                        <Button Click="Refresh_Click" ToolTipService.ToolTip="刷新状态">
                            <FontIcon FontSize="14" Glyph="&#xE72C;" />
                        </Button>
                        <Button
                            x:Name="LogoutButton"
                            Click="Logout_Click"
                            Content="退出登录"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 扫码面板 -->
            <Border
                x:Name="QrPanel"
                Margin="0,12,0,0"
                Style="{StaticResource CardStyle}"
                Visibility="Collapsed">
                <Grid ColumnSpacing="32">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="224"
                        Height="224"
                        Padding="12"
                        Background="White"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid>
                            <Image x:Name="QrImage" Stretch="Uniform" />
                            <ProgressRing x:Name="QrRing" Width="40" Height="40" IsActive="False" />
                            <Border
                                x:Name="QrMask"
                                Background="#E6FFFFFF"
                                Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                                    <FontIcon x:Name="QrMaskIcon" FontSize="36" Foreground="#0F7B0F" Glyph="&#xE73E;" />
                                    <TextBlock
                                        x:Name="QrMaskText"
                                        HorizontalAlignment="Center"
                                        Foreground="#1A1A1A"
                                        Text="已扫码" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="10">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="用哔哩哔哩手机 App 扫码" />
                        <TextBlock LineHeight="24" Style="{StaticResource BodyTextBlockStyle}">
                            <Run Text="1. 打开手机上的哔哩哔哩 App" />
                            <LineBreak />
                            <Run Text="2. 点击首页左上角头像旁的「扫一扫」（或 我的 → 扫一扫）" />
                            <LineBreak />
                            <Run Text="3. 扫描左侧二维码，并在手机上点击「确认登录」" />
                        </TextBlock>
                        <InfoBar
                            x:Name="QrStatusBar"
                            IsClosable="False"
                            IsOpen="True"
                            Message="等待扫码…"
                            Severity="Informational" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="RefreshQr_Click" Content="刷新二维码" />
                            <Button Click="CancelQr_Click" Content="取消" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 画质说明 -->
            <TextBlock Style="{StaticResource SectionHeaderStyle}" Text="不同身份可下载的画质" />
            <Border Padding="0" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Padding="20,16" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE7EE;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="未登录" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" FontSize="14" Text="最高 1080P，部分视频只有 480P / 720P" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="20,16" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Glyph="&#xE77B;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="已登录" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" FontSize="14" Text="1080P 高清、1080P60 高帧率" />
                    </Grid>
                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <Grid Padding="20,16" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="16" Foreground="#FB7299" Glyph="&#xE735;" />
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="大会员" />
                        </StackPanel>
                        <TextBlock
                            Grid.Column="1"
                            FontSize="14"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="1080P+ 高码率、4K 超清、HDR 真彩、杜比视界、8K 超高清，以及 Hi-Res 无损 / 杜比全景声音轨" />
                    </Grid>
                </StackPanel>
            </Border>

            <InfoBar
                Margin="0,16,0,0"
                IsClosable="False"
                IsOpen="True"
                Message="登录凭据用 Windows 数据保护（DPAPI）加密后只保存在本机，文件被拷到其他电脑或其他 Windows 账户上都无法解密，也不会上传到任何地方。点「退出登录」会先让这次登录在 B站服务器上失效，再删除本机文件。请只用于下载你有权观看的内容。"
                Severity="Informational"
                Title="隐私说明" />
        </StackPanel>
    </ScrollViewer>
</Page>
